# Salin jadi .env lalu jalankan:  uvicorn app.main:app --env-file .env --port 8000

# Lokasi isi zip SuperGallery (boleh langsung hasil ekstrak, folder bersarang dicari otomatis)
ARTIFACTS_DIR=artifacts
# model = DINOv3 + SigLIP2 asli; fake = encoder tiruan untuk tes tanpa torch
ENCODER=model
# auto | cpu | cuda
DEVICE=auto
# all = semua foto berklaster (galeri + validasi); index = persis retrieval_export notebook
GALLERY=all

# Ambang "dikenali" (kosongkan untuk pakai angka bawaan config.json). Isi dari tune_threshold.py
TAU_ACCEPT=
TAU_MARGIN=

# Live: barang dianggap sama kalau embedding-nya >= DEDUP_COS dalam DEDUP_SEC detik
DEDUP_COS=0.95
DEDUP_SEC=3

# Build FE yang disajikan di http://localhost:8000
FE_DIST=../sipilah-fe/dist
DATA_DIR=data
MAX_UPLOAD_MB=15
# 0 = biarkan torch memilih
TORCH_THREADS=0
